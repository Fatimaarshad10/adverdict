# ==========================================================================
# AdVerdict environment configuration
# Copy this file to ".env.local" and fill in your real values.
# NEVER commit .env.local — it contains secrets.
# ==========================================================================

# --- Mode -----------------------------------------------------------------
# MOCK = run the full flow WITHOUT Band/LLM keys (great for first run + UI demo).
# LIVE = use real Band rooms + a real LLM.
ADVERDICT_MODE=MOCK

# --- LLM (OpenAI-compatible; Groq is free + fast and works out of the box) ---
# Groq:    https://console.groq.com/keys   base_url https://api.groq.com/openai/v1
# OpenAI:  https://platform.openai.com/api-keys   base_url https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Vision model used when an ad image is uploaded (the agents "see" the image).
# Groq:   meta-llama/llama-4-scout-17b-16e-instruct
# OpenAI: gpt-4o
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Band Agent API keys --------------------------------------------------
# Create 5 "External Agent"s in Band (https://app.band.ai/agents).
# For each, copy its API key here. The Coordinator owns/creates the room.
BAND_BASE_URL=https://app.band.ai/api/v1
BAND_COORDINATOR_KEY=
BAND_STRATEGY_KEY=
BAND_COPY_KEY=
BAND_COMPLIANCE_KEY=
BAND_PERFORMANCE_KEY=

# --- Supabase (auth + saved reviews) -------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
